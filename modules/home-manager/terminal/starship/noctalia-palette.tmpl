
# ---------------------------------------------------------------------------
# Rendered by Noctalia from the current wallpaper. See the [theme.templates.user]
# entry in modules/home-manager/windowManager/hyprland/noctalia.nix.
#
# Only the names this prompt actually references are defined. The terminal_*
# tokens are the same 16 ANSI colours Noctalia writes into the ghostty theme, so
# the prompt and the terminal it sits in are generated from one source.
# ---------------------------------------------------------------------------
[palettes.noctalia]
base     = "{{colors.terminal_background.default.hex}}"
